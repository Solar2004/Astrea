<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI de Astrea para Windows. Empaqueta astrea-agent.exe + install.ps1 y, al
  instalar, ejecuta install.ps1 (que registra las tareas, el firewall y la
  config con su token). Al desinstalar corre install.ps1 en modo uninstall.
  Toda la logica vive en install.ps1 para no duplicarla en WiX.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Astrea Agent"
           Manufacturer="Astrea"
           Version="$(var.Version)"
           UpgradeCode="4F87E493-748F-45E2-B5E5-05C0868DC75A"
           Scope="perMachine">
    <!-- afterInstallExecute: la version vieja se quita al final, cuando los
         archivos nuevos ya estan escritos (los componentes comparten GUID, asi
         que no se borran). Con afterInstallInitialize + StopAgent delante,
         Windows Installer rechaza la secuencia (error 2613). -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="Ya hay una version mas reciente de Astrea instalada." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ProgramData\Astrea: aqui viven exe, config, logs (igual que install.ps1). -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="INSTALLDIR" Name="Astrea" />
    </StandardDirectory>

    <ComponentGroup Id="Payload" Directory="INSTALLDIR">
      <Component Id="AgentExe" Guid="*">
        <File Id="AgentExe" Source="$(var.AgentExe)" KeyPath="yes" Name="astrea-agent.exe" />
      </Component>
      <Component Id="InstallPs1" Guid="*">
        <File Id="InstallPs1" Source="$(var.InstallPs1)" KeyPath="yes" Name="install.ps1" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Astrea Agent" Level="1">
      <ComponentGroupRef Id="Payload" />
    </Feature>

    <!--
      Custom actions: install.ps1 hace todo el trabajo, lanzado por WixQuietExec64
      (deferred, como SYSTEM, sin ventana; su salida va al log del MSI).

      Reglas que rompieron la 0.2.0 (siempre 1603, WixQuietExec64 0x80070057):
      - WixQuietExec exige que el comando EMPIECE con la ruta del exe entre
        comillas (wix v4 src/ext/Util/ca/qtexecca.cpp); si no, E_INVALIDARG.
      - El valor es texto "Formatted" de MSI: [PROP] se sustituye y unas llaves
        { } que contienen [PROP] se eliminan. Por eso nada de &{ ... }.
      SetProperty (inmediato) resuelve [INSTALLDIR] y deja el comando en la
      propiedad con el mismo Id que la custom action, que es de donde la lee
      WixQuietExec64.
      ASTREA_MSI=1 hace que install.ps1 no pregunte nada, no intente el login
      interactivo de Tailscale y escriba su log en ProgramData\Astrea\install.log.
      ASTREA_MSI_USER=[LogonUser]: quien abrio el MSI, dueno de las tareas.
      ASTREA_ADDR (propiedad publica, vacia por defecto): msiexec ... ASTREA_ADDR=127.0.0.1
      instala sin Tailscale; la usa el CI para probar el MSI de verdad.
    -->
    <SetProperty Id="StopAgent" Before="StopAgent" Sequence="execute"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Stop-ScheduledTask -TaskName AstreaAgent -ErrorAction SilentlyContinue; Stop-ScheduledTask -TaskName AstreaAgentGUI -ErrorAction SilentlyContinue; Get-Process -Name astrea-agent -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 800&quot;" />
    <CustomAction Id="StopAgent" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="RunInstall" Before="RunInstall" Sequence="execute"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$env:ASTREA_MSI='1'; $env:ASTREA_MSI_USER='[LogonUser]'; $env:ASTREA_LOCAL_EXE='[INSTALLDIR]astrea-agent.exe'; $env:ASTREA_ADDR='[ASTREA_ADDR]'; &amp; '[INSTALLDIR]install.ps1'; exit $LASTEXITCODE&quot;" />
    <CustomAction Id="RunInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="RunUninstall" Before="RunUninstall" Sequence="execute"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$env:ASTREA_MSI='1'; $env:ASTREA_UNINSTALL='1'; &amp; '[INSTALLDIR]install.ps1'; exit $LASTEXITCODE&quot;" />
    <CustomAction Id="RunUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Antes de tocar archivos: si el agente corre, su exe esta bloqueado y
           Windows dejaria la actualizacion pendiente de reinicio. -->
      <!-- NOT UPGRADINGPRODUCTCODE: al actualizar, la desinstalacion anidada
           del MSI viejo corre sus propias custom actions DESPUES de que el
           nuevo ya arranco el agente, y lo volvia a matar. -->
      <Custom Action="StopAgent" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <!-- Tambien en reparacion: vuelve a registrar tareas/firewall. -->
      <Custom Action="RunInstall" After="InstallFiles" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <!-- No en una actualizacion: el MSI viejo se desinstala y borraria la
           config y el token (el hub dejaria de valer). -->
      <Custom Action="RunUninstall" Before="RemoveFiles" Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
