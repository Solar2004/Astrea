  "files": [
    {
      "path": "ComfyUI_windows_portable/ComfyUI/extra_model_paths.yaml",
      "content": "lorian:\n  base_path: C:/lorian/models\n  diffusion_models: diffusion_models\n  text_encoders: text_encoders\n  vae: vae\n  loras: loras\n  model_patches: model_patches\n  upscale_models: upscale_models\n  background_removal: background_removal\n"
    }
  ],
  "setup": [
    {
      "name": "carpetas",
      "shell": "powershell",
      "creates": "${root}\\tmp",
      "run": "New-Item -ItemType Directory -Force '${root}\\out','${root}\\tmp' | Out-Null"
    },
    {
      "name": "nodo LorianStylize",
      "shell": "powershell",
      "creates": "${root}\\ComfyUI_windows_portable\\ComfyUI\\custom_nodes\\ComfyUI-LorianStylize",
      "run": "cmd /c mklink /J '${root}\\ComfyUI_windows_portable\\ComfyUI\\custom_nodes\\ComfyUI-LorianStylize' '${root}\\kit\\nodes\\ComfyUI-LorianStylize'; $req='${root}\\kit\\nodes\\ComfyUI-LorianStylize\\requirements.txt'; if (Test-Path $req) { & '${root}\\ComfyUI_windows_portable\\python_embeded\\python.exe' -m pip install -q -r $req }"
    },
    {
      "name": "cortafuegos 8188",
      "shell": "powershell",
      "unless": "Get-NetFirewallRule -DisplayName 'Lorian 8188' -ErrorAction SilentlyContinue",
      "run": "New-NetFirewallRule -DisplayName 'Lorian 8188' -Direction Inbound -Protocol TCP -LocalPort 8188 -Action Allow -Profile Any | Out-Null"
    }
  ],
  "services": [
    {
      "name": "comfyui",
      "command": "${root}\\ComfyUI_windows_portable\\python_embeded\\python.exe -s ${root}\\ComfyUI_windows_portable\\ComfyUI\\main.py --windows-standalone-build --disable-mmap --reserve-vram 1.0 --fast fp8_matrix_mult --listen 0.0.0.0 --port 8188 --output-directory ${root}\\out",
      "cwd": "${root}\\ComfyUI_windows_portable",
      "restart": "on-failure",
      "autostart": true,
      "ready": {
        "url": "http://127.0.0.1:8188/system_stats"
      },
      "expose": {
        "endpoint": "comfyui",
        "port": 8188,
        "api": "comfyui",
        "auth": "none"
      }
    }
  ],
  "resources": {
    "gpu_mb": 14500,
    "gpu_exclusive": false
  },
  "global": false,
  "notes": [
    "--listen 0.0.0.0 se mantiene porque farm/ de lorian-studio habla con el 8188 directo. Para pasar a auth:key hay que escuchar en 127.0.0.1 y usar solo /dyn/comfyui.",
    "Sustituye a 'fleet.py services' y a 'lorian-share' (el agente sirve los artefactos por /files/)."
  ]
}